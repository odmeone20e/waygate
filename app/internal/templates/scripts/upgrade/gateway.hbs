docker pull {{ waygateGatewayContainerImage }} && \
docker stop {{ waygateGatewayContainerName }} && \
docker rm {{ waygateGatewayContainerName }} && \
docker run -d --cap-drop ALL \
	--cap-add NET_ADMIN --cap-add NET_RAW --cap-add NET_BIND_SERVICE \
	--device /dev/net/tun \
	--security-opt no-new-privileges:true \
	--sysctl "net.ipv4.ip_forward=1" \
	--sysctl "net.ipv4.conf.all.src_valid_mark=1" \
	--restart=unless-stopped \
	-p 80:80/tcp -p 443:443/tcp \
	-p 51820:51820/udp \
	-p 4060:4060/tcp \
	-p 32420-32421:32420-32421/tcp -p 32420-32421:32420-32421/udp \
	-e DATABASE_PATH=/app/waygate/waygate.db \
	-v /var/run/docker.sock:/var/run/docker.sock \
	-v ~/.waygate-docker/gateway:/app/waygate \
	--name {{ waygateGatewayContainerName }} \
	{{ waygateGatewayContainerImage }} gateway
