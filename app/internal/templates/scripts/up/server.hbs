docker pull {{ waygateServerContainerImage }} && \
docker run -d \
  --cap-drop ALL \
  --cap-add NET_ADMIN \
  --cap-add NET_RAW \
  --cap-add NET_BIND_SERVICE \
  --security-opt no-new-privileges:true \
  --restart=unless-stopped \
  --sysctl "net.ipv4.ip_forward=1" \
  --sysctl "net.ipv4.conf.all.src_valid_mark=1" \
  -e DATABASE_PATH=/app/waygate/waygate.db \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v ~/.waygate-docker/server:/app/waygate \
  --name {{ waygateServerContainerName }} \
  {{ waygateServerContainerImage }} join {{ serverJoinToken }}
