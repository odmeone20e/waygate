docker pull {{ waygateServerContainerImage }} && docker run -d --privileged --sysctl "net.ipv4.ip_forward=1" --sysctl "net.ipv4.conf.all.src_valid_mark=1" \
	-e DATABASE_PATH=/app/waygate/waygate.db \
	-v /var/run/docker.sock:/var/run/docker.sock \
	-v ~/.waygate/server:/app/waygate \
	--name {{ waygateServerContainerName }} \
	{{ waygateServerContainerImage }} join {{ serverJoinToken }}
